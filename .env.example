# ============================================================================
# Vision AI - environment template.  Copy to `.env` and fill in what you use.
#   cp .env.example .env
# Vision AI boots with ZERO keys set (mock provider + hash embeddings), so you
# can run the whole stack offline before spending a cent.
# ============================================================================

# ---- Core LLM routing ------------------------------------------------------
# Provider for the main reasoning loop: openai | anthropic | ollama | mock
VISION_LLM_PROVIDER=mock
VISION_LLM_MODEL=gpt-4o-mini

# Per-role model overrides. Leave blank to inherit VISION_LLM_MODEL.
# The Guardian is called on EVERY tool call, so a small fast model is ideal.
VISION_PLANNER_MODEL=
VISION_WORKER_MODEL=
VISION_GUARDIAN_MODEL=
VISION_REFLECTION_MODEL=

VISION_LLM_TEMPERATURE=0.2
VISION_LLM_MAX_TOKENS=2048
VISION_LLM_TIMEOUT_SECONDS=90

# ---- Provider credentials --------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings ------------------------------------------------------------
# openai | hash   ("hash" = deterministic local embeddings, no network, no key)
VISION_EMBEDDING_PROVIDER=hash
VISION_EMBEDDING_MODEL=text-embedding-3-small
VISION_EMBEDDING_DIM=1536
# (the local "hash" embedder ignores this and uses 1024 dims)

# ---- Vector memory (ChromaDB) ---------------------------------------------
VISION_CHROMA_PATH=./data/chroma
VISION_TWIN_COLLECTION=vision_digital_twin
VISION_SKILL_COLLECTION=vision_skills

# ---- YouTube Skill Acquisition --------------------------------------------
# whisper_api  -> OpenAI Whisper (needs OPENAI_API_KEY, needs ffmpeg)
# captions     -> scrape YouTube's own captions with yt-dlp (free, no key)
# auto         -> captions first, fall back to whisper_api
VISION_TRANSCRIBER=auto
VISION_WHISPER_MODEL=whisper-1
VISION_SKILL_CHUNK_CHARS=1200
VISION_SKILL_CHUNK_OVERLAP=200
VISION_SKILL_MATCH_THRESHOLD=0.14
VISION_AUDIO_CACHE=./data/audio

# ---- Goal Mode -------------------------------------------------------------
# Durable runs: every node transition is checkpointed, so a run killed by a
# restart can be resumed instead of re-paying for work already done.
VISION_CHECKPOINT_ENABLED=true
VISION_CHECKPOINT_PATH=./data/checkpoints.sqlite

VISION_MAX_SUBTASKS=12
VISION_MAX_CONCURRENCY=4
VISION_MAX_TASK_RETRIES=2
VISION_GOAL_WALL_CLOCK_SECONDS=1800

# ---- Guardian / Constitutional AI -----------------------------------------
# Set false ONLY for trusted offline experiments. Goal Mode without a Guardian
# is an autonomous agent with a shell. Don't.
VISION_GUARDIAN_ENABLED=true
# enforce | monitor   (monitor = log violations but allow; for tuning only)
VISION_GUARDIAN_MODE=enforce
VISION_GUARDIAN_LLM_REVIEW=true

# ---- Human-in-the-loop approvals ------------------------------------------
# human | auto_approve | auto_deny   (auto_* are for unattended runs only)
VISION_APPROVAL_MODE=human
# Unanswered approval requests are DENIED at this deadline (fail-closed).
VISION_APPROVAL_TIMEOUT_SECONDS=300

# ---- Execution sandbox -----------------------------------------------------
# docker | subprocess | disabled
VISION_EXECUTOR=docker
VISION_DOCKER_IMAGE=python:3.11-slim
VISION_EXEC_TIMEOUT_SECONDS=120
VISION_EXEC_MEMORY_LIMIT=512m
VISION_EXEC_CPU_LIMIT=1.0
VISION_EXEC_NETWORK=none
VISION_WORKSPACE_DIR=./data/workspace

# ---- Proactive Intuition ---------------------------------------------------
VISION_PROACTIVE_ENABLED=true
VISION_PROACTIVE_MIN_CONFIDENCE=0.55
VISION_PROACTIVE_COOLDOWN_SECONDS=180

# ---- Server ----------------------------------------------------------------
VISION_HOST=0.0.0.0
VISION_PORT=8000
VISION_CORS_ORIGINS=*
VISION_LOG_LEVEL=INFO
